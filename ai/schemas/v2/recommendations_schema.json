{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AIRecommendationResult",
  "type": "object",
  "properties": {
    "title": { "type": "string" },
    "body": { "type": "string" },
    "suggested_action": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
  },
  "required": ["title", "body", "suggested_action", "confidence"]
}
