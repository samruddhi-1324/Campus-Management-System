# Campus Care Environment Variables
# Copy this file to .env and populate with actual credentials

# App Configuration
ENVIRONMENT=development  # development | staging | production
DEBUG=true
APP_NAME="Campus Care"
API_V1_STR="/api/v1"
SECRET_KEY="replace-with-a-secure-random-secret-key"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Supabase Managed PostgreSQL Database (Pooled Connection)
# Example: postgresql+asyncpg://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/campus_care"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30

# Supabase Storage Configuration
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET_ATTACHMENTS="issue-attachments"
SIGNED_URL_EXPIRATION_SECONDS=3600

# Redis / Task Queue Configuration
REDIS_URL="redis://localhost:6379/0"

# AI / LLM Advisory Subsystem
AI_PROVIDER="anthropic"  # anthropic | openai | mock
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
AI_MODEL_NAME="claude-3-7-sonnet-20250219"
AI_TIMEOUT_SECONDS=15
AI_DAILY_TOKEN_BUDGET=100000

# Communications & Notifications (Section 10)
# Email Configuration (smtp for dev/local, brevo for prod, resend for failover)
EMAIL_PROVIDER="smtp"  # smtp | brevo | resend
EMAIL_FALLBACK_PROVIDER="resend"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-gmail-app-password"
EMAILS_FROM_EMAIL="campuscare-noreply@institution.edu"
EMAILS_FROM_NAME="Campus Care"

BREVO_API_KEY=""
RESEND_API_KEY=""

# SMS Gateway Configuration
SMS_GATEWAY_PROVIDER="twilio"
SMS_ACCOUNT_SID=""
SMS_AUTH_TOKEN=""
SMS_FROM_NUMBER=""

# WhatsApp Business Cloud API (Meta OAuth 2.0)
WHATSAPP_API_URL="https://graph.facebook.com/v19.0"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_APP_SECRET=""

# Firebase Cloud Messaging (Push - Android, iOS, macOS, Web)
FIREBASE_CREDENTIALS_PATH="secrets/firebase-service-account.json"

# Client Version & Policy (FR-PLAT-16)
MINIMUM_SUPPORTED_CLIENT_VERSION="1.0.0"
